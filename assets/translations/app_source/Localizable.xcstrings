          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ձեր տվյալները մնում են գաղտնի: Սկանավորման և մաքրման ողջ մշակումն իրականացվում է տեղական եղանակով՝ ձեր iPhone-ում:"
