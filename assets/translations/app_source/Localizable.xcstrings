    "cardTwoSubTitle" : {
      "comment" : "Description of the second onboarding card.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verfolgen Sie Ihre vergangenen Aktivitäten, Guthabenänderungen und abgeschlossenen Vorgänge in einem übersichtlichen Protokoll."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Track all your past activity, balance changes, and completed operations in one organized log."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realiza un seguimiento de tu actividad pasada, cambios de saldo y operaciones completadas en un registro organizado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivez toutes vos activités passées, modifications de solde et opérations effectuées dans un journal organisé."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Հետևեք ձեր անցյալի գործողություններին, մնացորդի փոփոխություններին և ավարտված գործարքներին մեկ կազմակերպված մատյանում:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traccia tutte le tue attività passate, i cambiamenti di saldo e le operazioni completate in un registro organizzato."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "История операций: Отслеживайте всю прошлую активность, изменения баланса и завершенные операции в удобном журнале."
          }
        }
      }
