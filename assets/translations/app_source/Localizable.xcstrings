    "region.zero_balance_desc" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Apple-ID-Guthaben muss genau null sein, bevor Apple dir erlaubt, die Region zu wechseln. Verwende die Smart-Clean-Funktion auf dem Hauptbildschirm."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Apple ID balance must be exactly zero before Apple allows you to change regions. Use the Smart Clean feature on the main screen to drain it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu saldo de Apple ID debe ser exactamente cero antes de que Apple te permita cambiar de región. Usa la función Smart Clean en la pantalla principal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre solde Apple ID doit être exactement à zéro avant de pouvoir changer de région. Utilisez la fonction Smart Clean sur l'écran principal."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ձեր Apple ID-ի մնացորդը պետք է լինի ճիշտ զրո, նախքան Apple-ը կթույլատրի փոխել տարածաշրջանը: Օգտագործեք Smart Clean ֆունկցիան հիմնական էկրանին՝ այն զրոյացնելու համար:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il saldo del tuo Apple ID deve essere esattamente zero prima che Apple ti permetta di cambiare regione. Usa la funzione Smart Clean nella schermata principale."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Баланс Apple ID должен быть равен нулю, прежде чем Apple разрешит сменить регион. Используйте функцию Smart Clean на главном экране для обнуления."
          }
        }
      }
    },
