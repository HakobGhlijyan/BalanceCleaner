    "region.subscriptions_canceled_desc" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kündige alle aktiven Abonnements (Apple Music, iCloud+, Netflix usw.) unter Einstellungen → Apple-ID → Abonnements."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancel all active subscriptions (Apple Music, iCloud+, Netflix, etc.) in Settings → Apple ID → Subscriptions. They will remain active until the end of the paid period."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancela todas las suscripciones activas (Apple Music, iCloud+, Netflix, etc.) en Ajustes → ID de Apple → Suscripciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annulez tous les abonnements actifs (Apple Music, iCloud+, Netflix, etc.) dans Réglages → Identifiant Apple → Abonnements."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Չեղարկեք բոլոր ակտիվ բաժանորդագրությունները (Apple Music, iCloud+, Netflix և այլն) Կարգավորումներ → Apple ID → Բաժանորդագրություններ բաժնում: Դրանք ակտիվ կմնան մինչև վճարված ժամանակահատվածի ավարտը:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annulla tutti gli abbonamenti attivi (Apple Music, iCloud+, Netflix, ecc.) in Impostazioni → ID Apple → Abbonamenti."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отмените все активные подписки (Apple Music, iCloud+, Netflix и т.д.) в Настройки → Apple ID → Подписки. Они останутся активными до конца оплаченного периода."
          }
        }
      }
    },
