    "guide.donation.desc" : {
      "comment" : "Description of the donation section in the app's guide.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie das Restguthaben bezahlen (0,50 €, 1,00 € usw.), unterstützen Sie direkt die unabhängige iOS-Entwicklung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you pay your remaining balance ($0.50, $1.00, etc.), you are donating directly to support independent iOS development."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
