    "guide.clear.step2.desc" : {
      "comment" : "Step 2 description for the guide.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaufen Sie einen Artikel oder geben Sie ein Trinkgeld in der App. Wenn der Preis das Guthaben übersteigt, zieht Apple den Rest von Ihrer Kreditkarte ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buy an item or tip in the app. If price exceeds balance, Apple charges the rest from your credit card."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compra un artículo o deja una propina en la app. Si el precio supera el saldo, Apple cobrará el resto de tu tarjeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achetez un article ou donnez un pourboire. Si le prix dépasse le solde, Apple débitera le reste sur votre carte."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Գնեք որևէ ապրանք կամ թողեք թեյավճար հավելվածում: Եթե գինը գերազանցում է մնացորդը, Apple-ը մնացած մասը կգանձի քարտից:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acquista un elemento o lascia una mancia nell'app. Se il prezzo supera il saldo, Apple addebiterà il resto sulla tua carta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Совершите покупку или отправьте чаевые. Если цена превышает баланс, Apple спишет остаток с привязанной карты."
          }
        }
      }
    },
