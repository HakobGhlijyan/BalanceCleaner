    "region.ready_desc" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn alle Schalter grün sind, tippe auf die Schaltfläche unten, um die App-Store-Einstellungen zu öffnen und dein Land oder deine Region zu ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Once all checkmarks are green, tap the button below to open the App Store settings page where you can change your country or region."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando todos los interruptores estén en verde, toca el botón de abajo para abrir los ajustes de la App Store y cambiar tu país o región."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque tous les interrupteurs sont verts, appuyez sur le bouton ci-dessous pour ouvrir les réglages de l'App Store et changer de pays ou de région."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Երբ բոլոր նշումները դառնան կանաչ, սեղմեք ներքևի կոճակը՝ App Store-ի կարգավորումները բացելու համար, որտեղ կարող եք փոխել երկիրը կամ տարածաշրջանը:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando tutti gli interruttori sono verdi, tocca il pulsante qui sotto per aprire le impostazioni dell'App Store e cambiare paese o regione."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда все переключатели станут зелёными, нажмите кнопку ниже, чтобы открыть настройки App Store, где можно сменить страну или регион."
          }
        }
      }
    },
