        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus datos se mantienen privados. Todo el procesamiento de escaneo y limpieza se realiza localmente en tu iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
