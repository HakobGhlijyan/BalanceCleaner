    "checkout.card_charge_footnote %@ %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple verwendet Ihr Apple-ID-Guthaben (%@) und belastet Ihre Karte mit den verbleibenden %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple will use your %@ Apple ID balance, and charge the remaining %@ to your linked credit card."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple usará su saldo de ID de Apple (%@) y cargará los %@ restantes a su tarjeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple utilisera le solde de votre identifiant Apple (%@) et facturera les %@ restants sur votre carte."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple-ը կօգտագործի ձեր %@ Apple ID-ի մնացորդը, իսկ մնացած %@-ը կգանձի կցված բանկային քարտից:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple utilizzerà il saldo del tuo ID Apple (%@) e addebiterà i restanti %@ sulla tua carta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple использует ваш баланс Apple ID (%@), а оставшиеся %@ спишет с привязанной банковской карты."
          }
