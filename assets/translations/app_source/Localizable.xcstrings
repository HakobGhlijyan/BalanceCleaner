          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Երբ վճարում եք մնացորդը ($0.50, $1.00 և այլն), դուք ուղղակիորեն աջակցում եք անկախ iOS մշակմանը:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando paghi il saldo residuo (0,50 €, 1,00 €, ecc.), stai donando direttamente per sostenere lo sviluppo indipendente iOS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оплачивая остаток на балансе ($0.50, $1.00 и т. д.), вы напрямую поддерживаете независимую разработку под iOS."
          }
        }
      }
    },
