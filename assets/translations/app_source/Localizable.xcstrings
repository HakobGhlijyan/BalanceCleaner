    "cardThreeSubTitle" : {
      "comment" : "Description of the third onboarding card.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereiten Sie Ihr Konto Schritt für Schritt auf einen Regionswechsel vor und stellen Sie sicher, dass Ihr Guthaben vollständig auf Null steht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepare your account for a region change step by step and ensure your balance is fully zeroed out."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepara tu cuenta para un cambio de región paso a paso y asegúrate de que tu saldo esté totalmente a cero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Préparez votre compte au changement de région étape par étape et assurez-vous que votre solde est totalement à zéro."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Քայլ առ քայլ պատրաստեք ձեր հաշիվը տարածաշրջանի փոփոխությանը և համոզվեք, որ մնացորդը լիովին զրոյացված է:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepara il tuo account per il cambio di regione passo dopo passo e assicurati che il tuo saldo sia completamente azzerato."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чек-лист региона: Пошагово подготовьте свой аккаунт к смене региона и убедитесь, что баланс полностью обнулен."
          }
        }
      }
    },
