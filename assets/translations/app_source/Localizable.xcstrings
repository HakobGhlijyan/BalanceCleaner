    "region.family_sharing_desc" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du einer Familienfreigabe-Gruppe angehörst, musst du sie vor dem Regionswechsel verlassen. Gehe zu Einstellungen → Apple-ID → Familienfreigabe → Familie verlassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you are part of a Family Sharing group, you must leave it before switching regions. Go to Settings → Apple ID → Family Sharing → Leave Family."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si formas parte de un grupo familiar, debes abandonarlo antes de cambiar de región. Ve a Ajustes → ID de Apple → En Familia → Salir de la familia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous faites partie d'un groupe de partage familial, vous devez le quitter avant de changer de région. Allez dans Réglages → Identifiant Apple → Partage familial → Quitter la famille."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Եթե ընդգրկված եք Ընտանեկան հասանելիության խմբում, անհրաժեշտ է դուրս գալ դրանից նախքան տարածաշրջանը փոխելը: Անցեք Կարգավորումներ → Apple ID → Ընտանեկան հասանելիություն → Դուրս գալ ընտանիքից:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se fai parte di un gruppo In Famiglia, devi lasciarlo prima di cambiare regione. Vai su Impostazioni → ID Apple → In Famiglia → Esci dalla famiglia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если вы состоите в группе Семейного доступа, необходимо выйти из неё перед сменой региона. Перейдите в Настройки → Apple ID → Семейный доступ → Покинуть семью."
          }
        }
      }
    },
