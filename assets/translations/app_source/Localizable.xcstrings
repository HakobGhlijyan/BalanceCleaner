    "cardOneSubTitle" : {
      "comment" : "Description of the first onboarding card.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scannen und bereinigen Sie schnell unnötige Mediendateien und Cache-Daten, um Speicherplatz freizugeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quickly scan and clean up unnecessary media files and cached data to free up your device storage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanea y limpia rápidamente archivos multimedia innecesarios y datos almacenados en caché para liberar espacio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analysez et nettoyez rapidement les fichiers multimédias inutiles et les données en cache pour libérer de l'espace."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Արագ սկանավորեք և մաքրեք ավելորդ մեդիաֆայլերն ու քեշավորված տվյալները՝ սարքի հիշողությունն ազատելու համար:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scansiona e pulisci rapidamente i file multimediali non necessari e i dati memorizzati nella cache per liberare spazio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Умная очистка: Быстро сканируйте и удаляйте ненужные медиафайлы и кэш для освобождения памяти устройства."
          }
        }
      }
    },
