    "guide.support.desc" : {
      "comment" : "Section description in the app's main guide.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Ihr Guthaben geringer ist als der Mindestkaufpreis, wenden Sie sich direkt an den Apple Support, um es manuell auf Null zu setzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you have a balance lower than any purchase price, contact Apple Support directly to manually zero it out."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tienes un saldo inferior al precio de cualquier compra, ponte en contacto con el Soporte de Apple para ponerlo a cero manualmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si votre solde est inférieur au prix de tout achat, contactez le support Apple pour le mettre à zéro manuellement."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Եթե մնացորդը ցածր է ցանկացած գնման գնից, կապվեք Apple-ի աջակցման ծառայության հետ՝ այն զրոյացնելու համար:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se hai un saldo inferiore al prezzo di qualsiasi acquisto, contatta il Supporto Apple per azzerarlo manualmente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если ваш баланс меньше стоимости любой покупки, обратитесь в службу поддержки Apple для его ручного обнуления."
          }
        }
      }
    },
